# Optional. A data.gov.sg API key only raises the rate limit; the app works without it.
DATAGOV_API_KEY=

# Telegram bot (server only). Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# The app's own address, e.g. https://sg-data-api.vercel.app (set in Vercel for Production).
# Previews use VERCEL_URL and VERCEL_AUTOMATION_BYPASS_SECRET, which Vercel provides itself.
APP_BASE_URL=
